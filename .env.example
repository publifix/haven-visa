# Copy this file to .env.local for local development.
# Never commit real values — .env.local is already gitignored.
# In Vercel: Project Settings -> Environment Variables (set for Production, Preview, and Development).

# Supabase project URL and public anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, full DB access. NEVER prefix with NEXT_PUBLIC_,
# never send to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=
