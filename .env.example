# Copy this file to .env.local for local development.
# Never commit real values — .env.local is already gitignored.
# In Vercel: Project Settings -> Environment Variables (set for Production, Preview, and Development).

# Supabase project URL and public anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-only, full DB access. NEVER prefix with NEXT_PUBLIC_,
# never send to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# The site's real production domain (e.g. https://salahaven.com), no trailing
# slash. Used for canonical URLs, Open Graph/Twitter tags, and the sitemap.
# Set this in Vercel once the production domain is decided — until then it
# falls back to a placeholder in next.config.mjs and SEO tags will be wrong.
NEXT_PUBLIC_SITE_URL=

# Resend API key — server-only, sends confirmation emails. NEVER prefix with
# NEXT_PUBLIC_, never send to the browser.
RESEND_API_KEY=

# "From" address for confirmation emails. Until a real domain is verified in
# Resend, leave unset — the API route falls back to the shared resend.dev
# test domain, which can only deliver to the email the Resend account was
# created with.
RESEND_FROM=

# Internal mailbox that gets a copy of every new reservation. Leave unset to
# skip the staff notification entirely (the guest confirmation still sends).
TGLE_STAFF_EMAIL=
